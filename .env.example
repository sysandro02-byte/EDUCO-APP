# ========================================================
# EDUCO - CONFIGURATION SUPABASE (BASE DE DONNÉES PRINCIPALE)
# ========================================================
# Supabase API REST & Auth (Client & Serveur)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Session and browser-origin security. Generate a long random value for
# AUTH_SESSION_SECRET; never reuse a Supabase service-role key here.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# Comma-separated frontend origins allowed to call the API in production.
CORS_ALLOWED_ORIGINS=https://educo-app.vercel.app
# Local development only. Keep false/undefined in production.
ALLOW_INSECURE_LOCAL_AUTH=false

# Supabase Direct PostgreSQL Connection (Database URL)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Gemini API
GEMINI_API_KEY=

# Groq API
GROQ_API_KEY=

# ========================================================
# EDUCO - CONFIGURATION BREVO (EMAILS TRANSACTIONNELS)
# ========================================================
# Clé API Brevo (v3)
BREVO_API_KEY=

# URL Endpoint Brevo
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Expéditeur Validé dans Brevo (Senders)
EMAIL_FROM=contacts@loukatech.com
EMAIL_FROM_NAME=EDUCO
EMAIL_TIMEOUT_MS=30000


